{
  "name": "dynamic-pricing",
  "schema": {
    "attributes": [
      { "name": "brand", "type": "string", "required": true },
      { "name": "market", "type": "string", "required": true },
      { "name": "inventory", "type": "numeric", "required": true },
      { "name": "list_price", "type": "numeric", "required": true },
      { "name": "global", "type": "json", "required": true }
    ]
  },
  "def": {
    "type": "decision_table",
    "hitPolicy": "first",
    "columns": [
      { "id": "c_brand", "left": { "kind": "attr", "path": "brand" }, "op": "eq" },
      { "id": "c_market", "left": { "kind": "attr", "path": "market" }, "op": "eq" },
      { "id": "c_inventory", "left": { "kind": "attr", "path": "inventory" }, "op": "gte" }
    ],
    "outputs": [
      { "id": "o_price", "key": "final_price" },
      { "id": "o_msg", "key": "promo_message" }
    ],
    "rows": [
      {
        "id": "chevy_domestic_guard",
        "priority": 10,
        "cells": {
          "c_brand": { "kind": "const", "value": "Chevrolet" },
          "c_market": { "kind": "const", "value": "domestic" },
          "c_inventory": null
        },
        "results": {
          "o_price": {
            "formula": {
              "kind": "call",
              "name": "max",
              "args": [
                { "kind": "attr", "path": "list_price" },
                { "kind": "attr", "path": "global.min_price_policy" }
              ]
            }
          },
          "o_msg": {
            "kind": "const",
            "value": "Chevrolet domestic: low inventory — list price holds."
          }
        }
      },
