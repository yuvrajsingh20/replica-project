# Migrations ONLY — direct Postgres (port 5432 OK here). Must contain localhost or _dev.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Runtime — transaction pooler (port 6543). Must NOT use :5432.
# Always: postgres(DATABASE_URL, { prepare: false })
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/postgres

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

ALLOW_TEST_USER_HEADER=1
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
